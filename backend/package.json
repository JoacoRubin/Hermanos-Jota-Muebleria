{
  "name": "hj-backend",
  "version": "2.0.0",
  "description": "Backend Express + Mongoose para Hermanos Jota Mueblería",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
